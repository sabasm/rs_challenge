{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES6",
    "jsx": "react-jsx",
    "outDir": "build",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "react-ui/node_modules/*"]
    }
  },
  "exclude": ["server/server", "server/react-ui", "react-ui/build", "react-ui/public"]
}
